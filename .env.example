# Pick ONE provider. Free options: gemini (aistudio.google.com) or groq (console.groq.com).
# The app auto-detects whichever key is present; LLM_PROVIDER forces a choice.
GEMINI_API_KEY=
GROQ_API_KEY=            # also enables free voice input (Whisper)

# Optional overrides - swap the model with no code changes:
# LLM_PROVIDER=gemini     # gemini | groq | openrouter | ollama | openai | anthropic | custom
# LLM_MODEL=gemini-2.5-flash
# LLM_BASE_URL=           # for `custom`: any OpenAI-compatible endpoint
# LLM_API_KEY=
# ANTHROPIC_API_KEY=      # LLM_PROVIDER=anthropic, default model claude-opus-5-5
# OPENAI_API_KEY=
