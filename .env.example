# Copy to .env and paste at least one free key right after the "=" (no quotes, no spaces).
# With both set, Groq is used first and Gemini is the automatic backup when a daily quota runs out.

# Groq: free at console.groq.com/keys - keys start with gsk_ - also turns on voice input (Whisper)
GROQ_API_KEY=

# Gemini: free at aistudio.google.com/apikey - keys start with AQ. or AIza
GEMINI_API_KEY=

# ---- Optional: swap the model with no code change ----
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
# LLM_FALLBACK=gemini:gemini-3.5-flash,gemini:gemini-3.5-flash-lite
# Any OpenAI-compatible endpoint: LLM_PROVIDER=custom, LLM_BASE_URL=..., LLM_API_KEY=...
# Paid options: ANTHROPIC_API_KEY= (default model claude-opus-5-5), OPENAI_API_KEY=
